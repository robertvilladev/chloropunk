{
  "name": "chloropunk",
  "private": true,
  "version": "0.1.0",
  "description": "A top-down 2D roguelike shooter built with Phaser 3 and TypeScript",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22",
    "npm": "use pnpm (see README)"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "sim": "vitest run src/core/sim.report.test.ts",
    "runs": "node scripts/runs.mjs",
    "playtest": "node scripts/playtest.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^27.2.0",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "index.js",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "keywords": [
    "game",
    "roguelike",
    "phaser",
    "typescript",
    "shooter"
  ],
  "author": "",
  "license": "MIT"
}
